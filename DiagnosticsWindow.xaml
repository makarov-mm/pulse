<Window x:Class="Pulse.DiagnosticsWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:loc="using:Pulse.Localization"
    xmlns:m="using:Pulse.Models" Title="{loc:Localize Key=Diagnostics}">
    <Grid x:Name="Surface" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}" Padding="16" RowSpacing="10">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions>
        <SelectorBar x:Name="Pages" SelectionChanged="PageChanged">
            <SelectorBarItem x:Name="WatchPage" Text="{loc:Localize Key=Pinned}"/>
            <SelectorBarItem x:Name="GpuPage" Text="GPU"/>
            <SelectorBarItem x:Name="ActivityPage" Text="{loc:Localize Key=ActivityTrace}"/>
        </SelectorBar>
        <InfoBar x:Name="Problem" Grid.Row="1" Severity="Warning" IsOpen="False"/>
        <ScrollViewer Grid.Row="2" x:Name="Charts" Visibility="Collapsed"><StackPanel x:Name="ChartsPanel" Spacing="12"/></ScrollViewer>
        <Grid Grid.Row="2" x:Name="Activity" Visibility="Collapsed" RowSpacing="8">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions>
            <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8"><Button x:Name="Elevate" Content="{loc:Localize Key=ElevateButton}" Click="ElevateClicked"/></StackPanel>
            <TextBlock x:Name="TraceStatus" Grid.Row="2"/>
            <ListView x:Name="Transfers" Grid.Row="3"><ListView.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" TextWrapping="Wrap" IsTextSelectionEnabled="True"/></DataTemplate></ListView.ItemTemplate></ListView>
        </Grid>
    </Grid>
</Window>
