<Window x:Class="Pulse.MainWindow" Title="{loc:Localize Key=WindowTitle}"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:loc="using:Pulse.Localization"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Pulse.Controls" xmlns:m="using:Pulse.Models">
    <Grid x:Name="Root" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}" Loaded="OnLoaded" SizeChanged="RootSizeChanged">
        <Grid.RowDefinitions><RowDefinition Height="38"/><RowDefinition Height="*"/><RowDefinition Height="32"/></Grid.RowDefinitions>
        <Grid x:Name="DragRegion" Background="Transparent">
            <StackPanel Orientation="Horizontal" Spacing="9" Margin="18,0,0,0" VerticalAlignment="Center">
                <Border Width="22" Height="22" CornerRadius="6" Background="{ThemeResource AccentFillColorDefaultBrush}">
                    <Path Data="M 2,9 L 5,9 7,4 10,14 12,8 16,8" Stroke="{ThemeResource TextOnAccentFillColorPrimaryBrush}" StrokeThickness="1.7" StrokeLineJoin="Round" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <TextBlock Text="Pulse" FontWeight="SemiBold" FontSize="13"/>
                <Border Height="13" Width="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" VerticalAlignment="Center"/>
                <TextBlock Text="{loc:Localize Key=AppSubtitle}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
            </StackPanel>
        </Grid>
        <Grid Grid.Row="1" x:Name="Workspace" Margin="24,12,24,12" RowSpacing="12">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <Grid>
                <StackPanel Spacing="2" VerticalAlignment="Center">
                    <TextBlock Text="{loc:Localize Key=Overview}" Style="{StaticResource TitleTextBlockStyle}"/>
                    <TextBlock x:Name="HostText" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button x:Name="AboutButton" Click="AboutClicked" AutomationProperties.Name="{loc:Localize Key=About}"
                            ToolTipService.ToolTip="{loc:Localize Key=About}" Padding="10,6">
                        <FontIcon Glyph="&#xE946;" FontSize="16"/>
                    </Button>
                    <ComboBox x:Name="SpanBox" SelectedIndex="0" SelectionChanged="SpanChanged" AutomationProperties.Name="{loc:Localize Key=SpanLabel}" ToolTipService.ToolTip="{loc:Localize Key=SpanLabel}">
                        <ComboBoxItem Content="{loc:Localize Key=SpanOne}"/><ComboBoxItem Content="{loc:Localize Key=SpanFifteen}"/>
                    </ComboBox>
                    <ComboBox x:Name="IntervalBox" SelectedIndex="1" SelectionChanged="IntervalChanged" AutomationProperties.Name="{loc:Localize Key=Interval}" ToolTipService.ToolTip="{loc:Localize Key=Interval}">
                        <ComboBoxItem Content="{loc:Localize Key=IntervalOne}"/><ComboBoxItem Content="{loc:Localize Key=IntervalTwo}"/><ComboBoxItem Content="{loc:Localize Key=IntervalFive}"/>
                    </ComboBox>
                    <ToggleButton x:Name="PauseButton" Click="PauseClicked" AutomationProperties.Name="{loc:Localize Key=PauseUpdates}">
                        <StackPanel Orientation="Horizontal" Spacing="7"><FontIcon x:Name="PauseIcon" Glyph="&#xE769;" FontSize="13"/><TextBlock x:Name="PauseLabel" Text="{loc:Localize Key=Pause}"/></StackPanel>
                    </ToggleButton>
                </StackPanel>
            </Grid>
            <ScrollViewer Grid.Row="1" x:Name="OverviewScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <Grid x:Name="Cards" ColumnSpacing="10" RowSpacing="0">
                        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <local:MetricCard x:Name="CpuCard" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                        <local:MetricCard Grid.Column="1" x:Name="MemoryCard" Foreground="{ThemeResource MemoryInk}"/>
                        <local:MetricCard Grid.Column="2" x:Name="DiskCard" Foreground="{ThemeResource DiskInk}"/>
                        <local:MetricCard Grid.Column="3" x:Name="NetworkCard" Foreground="{ThemeResource NetworkInk}"/>
                    </Grid>
                    <Border Grid.Row="1" x:Name="DevicePanel" Visibility="Collapsed" Margin="0,10,0,0" Padding="15,10,15,12" Style="{StaticResource Surface}">
                        <Grid RowSpacing="8">
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                            <Grid ColumnSpacing="10">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <TextBlock x:Name="DeviceTitle" VerticalAlignment="Center" Style="{StaticResource BodyStrongTextBlockStyle}"/>
                                <TextBlock Grid.Column="1" x:Name="DeviceSpan" VerticalAlignment="Center" FontSize="12" TextTrimming="CharacterEllipsis" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                <Button Grid.Column="2" Margin="0,-4,-6,-4" Style="{StaticResource SubtleButtonStyle}" Click="CloseDevices" AutomationProperties.Name="{loc:Localize Key=CloseDevices}" ToolTipService.ToolTip="{loc:Localize Key=CloseDevices}"><FontIcon Glyph="&#xE711;" FontSize="12"/></Button>
                            </Grid>
                            <ScrollViewer Grid.Row="1" x:Name="DeviceScroll" MaxHeight="190" VerticalScrollBarVisibility="Auto">
                                <Grid x:Name="DeviceGrid" ColumnSpacing="8" RowSpacing="8" TabFocusNavigation="Once" XYFocusKeyboardNavigation="Enabled" SizeChanged="DeviceGridSizeChanged"/>
                            </ScrollViewer>
                            <TextBlock Grid.Row="1" x:Name="DeviceEmpty" Text="{loc:Localize Key=NoDevices}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        </Grid>
                    </Border>
                </Grid>
            </ScrollViewer>
            <InfoBar Grid.Row="2" x:Name="ErrorBar" IsOpen="False" IsClosable="True" Severity="Warning"/>
            <Border Grid.Row="3" Style="{StaticResource Surface}">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <Grid Padding="15,12" ColumnSpacing="10">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <SelectorBar x:Name="Tabs" Margin="-8,-6,0,-6" SelectionChanged="TabChanged">
                                <SelectorBarItem x:Name="ProcessesTab"/>
                                <SelectorBarItem x:Name="DetailsTab"/>
                                <SelectorBarItem x:Name="UsersTab"/>
                                <SelectorBarItem x:Name="ConnectionsTab"/>
                                <SelectorBarItem x:Name="StartupTab"/>
                                <SelectorBarItem x:Name="ServicesTab"/>
                                <SelectorBarItem x:Name="SpaceTab"/>
                            </SelectorBar>
                            <TextBlock x:Name="CountText" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        </StackPanel>
                        <TextBox Grid.Column="2" x:Name="SearchBox" Width="214" PlaceholderText="{loc:Localize Key=Search}" AutomationProperties.Name="{loc:Localize Key=Search}" TextChanged="SearchChanged">
                            <TextBox.KeyboardAccelerators><KeyboardAccelerator Key="F" Modifiers="Control" Invoked="SearchInvoked"/></TextBox.KeyboardAccelerators>
                        </TextBox>
                        <ToggleButton Grid.Column="3" x:Name="TreeButton" IsChecked="True" Click="TreeClicked" AutomationProperties.Name="{loc:Localize Key=ProcessTree}" ToolTipService.ToolTip="{loc:Localize Key=TreeTip}">
                            <StackPanel Orientation="Horizontal" Spacing="7"><FontIcon Glyph="&#xE8FD;" FontSize="14"/><TextBlock x:Name="TreeLabel" Text="{loc:Localize Key=Tree}"/></StackPanel>
                        </ToggleButton>
                    </Grid>
                    <SplitView Grid.Row="1" x:Name="Inspector" PanePlacement="Right" DisplayMode="Inline" OpenPaneLength="290" IsPaneOpen="False">
                        <SplitView.Pane>
                            <Border BorderThickness="1,1,0,0" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" Background="{ThemeResource LayerFillColorDefaultBrush}">
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <StackPanel Padding="16" Spacing="12">
                                        <Grid>
                                            <TextBlock Text="{loc:Localize Key=Details}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center"/>
                                            <Button HorizontalAlignment="Right" Style="{StaticResource SubtleButtonStyle}" Click="CloseInspector" AutomationProperties.Name="{loc:Localize Key=CloseDetails}" ToolTipService.ToolTip="{loc:Localize Key=CloseDetails}"><FontIcon Glyph="&#xE711;" FontSize="12"/></Button>
                                        </Grid>
                                        <TextBlock x:Name="DetailName" FontSize="21" FontWeight="SemiBold" TextWrapping="Wrap" IsTextSelectionEnabled="True"/>
                                        <TextBlock x:Name="DetailPid" Margin="0,-8,0,0" Style="{StaticResource CaptionTextBlockStyle}"/>
                                        <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}"/>
                                        <StackPanel x:Name="DetailFacts" Spacing="6"/>
                                        <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}"/>
                                        <StackPanel Spacing="4">
                                            <TextBlock Text="{loc:Localize Key=Executable}" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                            <TextBlock x:Name="DetailPath" FontSize="13" TextWrapping="Wrap" IsTextSelectionEnabled="True"/>
                                        </StackPanel>
                                        <Button x:Name="EndButton" Click="EndClicked" HorizontalAlignment="Stretch"><StackPanel Orientation="Horizontal" Spacing="7"><FontIcon Glyph="&#xE71A;" FontSize="14"/><TextBlock Text="{loc:Localize Key=EndTask}"/></StackPanel></Button>
                                    </StackPanel>
                                </ScrollViewer>
                            </Border>
                        </SplitView.Pane>
                        <Grid x:Name="TableViewport" SizeChanged="TableSizeChanged">
                            <ScrollViewer HorizontalScrollBarVisibility="Auto" HorizontalScrollMode="Enabled" VerticalScrollBarVisibility="Disabled" VerticalScrollMode="Disabled">
                                <Grid x:Name="TableBody" HorizontalAlignment="Left">
                                    <Grid.RowDefinitions><RowDefinition Height="36"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                                    <Border Background="{ThemeResource SubtleFillColorSecondaryBrush}" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,1">
                                        <Grid Padding="12,0,16,0">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="60"/><ColumnDefinition Width="80"/><ColumnDefinition Width="106"/><ColumnDefinition Width="122"/><ColumnDefinition Width="70"/></Grid.ColumnDefinitions>
                                            <Button x:Name="NameHeader" HorizontalContentAlignment="Left" Tag="Name" Click="SortClicked" Style="{StaticResource TableHeader}"/>
                                            <Button x:Name="PidHeader" Grid.Column="1" Tag="Pid" Click="SortClicked" Style="{StaticResource TableHeader}"/>
                                            <Button x:Name="CpuHeader" Grid.Column="2" Tag="Cpu" Click="SortClicked" Style="{StaticResource TableHeader}"/>
                                            <Button x:Name="RamHeader" Grid.Column="3" Tag="Ram" Click="SortClicked" Style="{StaticResource TableHeader}"/>
                                            <Button x:Name="IoHeader" Grid.Column="4" Tag="Io" Click="SortClicked" Style="{StaticResource TableHeader}" ToolTipService.ToolTip="{loc:Localize Key=IoTip}"/>
                                            <Button x:Name="ThreadsHeader" Grid.Column="5" Tag="Threads" Click="SortClicked" Style="{StaticResource TableHeader}"/>
                                        </Grid>
                                    </Border>
                                    <ListView Grid.Row="1" x:Name="TaskList" SelectionMode="Single" SelectionChanged="TaskSelected" AutomationProperties.Name="{loc:Localize Key=ProcessList}"
                                        ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.HorizontalScrollMode="Disabled" Padding="0">
                                        <ListView.ItemContainerTransitions><TransitionCollection/></ListView.ItemContainerTransitions>
                                        <ListView.ItemContainerStyle>
                                            <Style TargetType="ListViewItem">
                                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Padding" Value="0"/>
                                                <Setter Property="Margin" Value="0"/><Setter Property="MinHeight" Value="36"/>
                                            </Style>
                                        </ListView.ItemContainerStyle>
                                        <ListView.ItemTemplate>
                                            <DataTemplate x:DataType="m:ProcessRow">
                                                <Grid Padding="12,0,16,0" MinHeight="36" AutomationProperties.Name="{x:Bind Accessible, Mode=OneWay}">
                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="60"/><ColumnDefinition Width="80"/><ColumnDefinition Width="106"/><ColumnDefinition Width="122"/><ColumnDefinition Width="70"/></Grid.ColumnDefinitions>
                                                    <Grid Margin="{x:Bind Indent, Mode=OneWay}" ColumnSpacing="6">
                                                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                                        <Grid Width="21" Visibility="{x:Bind BranchSpace, Mode=OneWay}">
                                                            <Button Visibility="{x:Bind ArrowVisibility, Mode=OneWay}" IsEnabled="{x:Bind CanExpand, Mode=OneWay}" Tag="{x:Bind}" Click="BranchClicked" MinWidth="20" Width="20" Height="27" Padding="0" Style="{StaticResource SubtleButtonStyle}" AutomationProperties.Name="{x:Bind BranchAction, Mode=OneWay}">
                                                                <FontIcon Glyph="{x:Bind Arrow, Mode=OneWay}" FontSize="10"/>
                                                            </Button>
                                                        </Grid>
                                                        <FontIcon Grid.Column="1" Glyph="{x:Bind Glyph, Mode=OneWay}" FontSize="15" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                                        <TextBlock Grid.Column="2" Text="{x:Bind Name, Mode=OneWay}" FontSize="13" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{x:Bind Name, Mode=OneWay}"/>
                                                    </Grid>
                                                    <TextBlock Grid.Column="1" Text="{x:Bind Pid, Mode=OneWay}" Style="{StaticResource NumberCell}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                                    <Border Grid.Column="2" Width="{x:Bind CpuWidth, Mode=OneWay}" Height="21" HorizontalAlignment="Right" Margin="0,0,3,0" CornerRadius="3" Background="{ThemeResource AccentFillColorDefaultBrush}" Opacity="0.2"/>
                                                    <TextBlock Grid.Column="2" Text="{x:Bind Cpu, Mode=OneWay}" Style="{StaticResource NumberCell}"/>
                                                    <TextBlock Grid.Column="3" Text="{x:Bind Ram, Mode=OneWay}" Style="{StaticResource NumberCell}"/>
                                                    <TextBlock Grid.Column="4" Text="{x:Bind Io, Mode=OneWay}" Style="{StaticResource NumberCell}"/>
                                                    <TextBlock Grid.Column="5" Text="{x:Bind Threads, Mode=OneWay}" Style="{StaticResource NumberCell}"/>
                                                </Grid>
                                            </DataTemplate>
                                        </ListView.ItemTemplate>
                                    </ListView>
                                </Grid>
                            </ScrollViewer>
                            <TextBlock x:Name="EmptyText" VerticalAlignment="Center" HorizontalAlignment="Center" Text="{loc:Localize Key=Collecting}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" IsHitTestVisible="False"/>
                        </Grid>
                    </SplitView>
                    <Grid Grid.Row="1" x:Name="DetailsView" Visibility="Collapsed" SizeChanged="DetailsSizeChanged">
                        <ScrollViewer HorizontalScrollBarVisibility="Auto" HorizontalScrollMode="Enabled" VerticalScrollBarVisibility="Disabled" VerticalScrollMode="Disabled">
                            <Grid x:Name="DetailsBody" HorizontalAlignment="Left">
                        <Grid.RowDefinitions><RowDefinition Height="36"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                        <Border Background="{ThemeResource SubtleFillColorSecondaryBrush}" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,1">
                            <Grid Padding="18,0,16,0" ColumnSpacing="12">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="64"/><ColumnDefinition Width="96"/><ColumnDefinition Width="72"/><ColumnDefinition Width="74"/><ColumnDefinition Width="100"/><ColumnDefinition Width="100"/><ColumnDefinition Width="100"/><ColumnDefinition Width="100"/><ColumnDefinition Width="70"/><ColumnDefinition Width="76"/><ColumnDefinition Width="150"/></Grid.ColumnDefinitions>
                                <TextBlock Text="{loc:Localize Key=Name}" Style="{StaticResource ColumnTitle}"/>
                                <TextBlock Grid.Column="1" Text="PID" HorizontalAlignment="Right" Margin="0,0,6,0" Style="{StaticResource ColumnTitle}"/>
                                <TextBlock Grid.Column="2" Text="{loc:Localize Key=ParentPid}" HorizontalAlignment="Right" Margin="0,0,6,0" Style="{StaticResource ColumnTitle}"/>
                                <TextBlock Grid.Column="3" Text="{loc:Localize Key=Session}" HorizontalAlignment="Right" Margin="0,0,6,0" Style="{StaticResource ColumnTitle}"/>
                                <TextBlock Grid.Column="4" Text="{loc:Localize Key=CPU}" HorizontalAlignment="Right" Margin="0,0,6,0" Style="{StaticResource ColumnTitle}"/>
                                <TextBlock Grid.Column="5" Text="{loc:Localize Key=WorkingSet}" HorizontalAlignment="Right" Margin="0,0,6,0" Style="{StaticResource ColumnTitle}"/>
                                <TextBlock Grid.Column="6" Text="{loc:Localize Key=PrivateBytes}" HorizontalAlignment="Right" Margin="0,0,6,0" Style="{StaticResource ColumnTitle}"/>
                                <TextBlock Grid.Column="7" Text="{loc:Localize Key=ReadRate}" HorizontalAlignment="Right" Margin="0,0,6,0" Style="{StaticResource ColumnTitle}"/>
                                <TextBlock Grid.Column="8" Text="{loc:Localize Key=WriteRate}" HorizontalAlignment="Right" Margin="0,0,6,0" Style="{StaticResource ColumnTitle}"/>
                                <TextBlock Grid.Column="9" Text="{loc:Localize Key=Threads}" HorizontalAlignment="Right" Margin="0,0,6,0" Style="{StaticResource ColumnTitle}"/>
                                <TextBlock Grid.Column="10" Text="{loc:Localize Key=Handles}" HorizontalAlignment="Right" Margin="0,0,6,0" Style="{StaticResource ColumnTitle}"/>
                                <TextBlock Grid.Column="11" Text="{loc:Localize Key=Started}" HorizontalAlignment="Right" Margin="0,0,6,0" Style="{StaticResource ColumnTitle}"/>
                            </Grid>
                        </Border>
                        <ListView Grid.Row="1" x:Name="DetailList" SelectionMode="Single" DoubleTapped="DetailDoubleTapped" Padding="0"
                            ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.HorizontalScrollMode="Disabled">
                            <ListView.ItemContainerTransitions><TransitionCollection/></ListView.ItemContainerTransitions>
                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Padding" Value="0"/>
                                    <Setter Property="Margin" Value="0"/><Setter Property="MinHeight" Value="34"/>
                                </Style>
                            </ListView.ItemContainerStyle>
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="m:DetailRow">
                                    <Grid Padding="18,0,16,0" MinHeight="34" ColumnSpacing="12">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="64"/><ColumnDefinition Width="96"/><ColumnDefinition Width="72"/><ColumnDefinition Width="74"/><ColumnDefinition Width="100"/><ColumnDefinition Width="100"/><ColumnDefinition Width="100"/><ColumnDefinition Width="100"/><ColumnDefinition Width="70"/><ColumnDefinition Width="76"/><ColumnDefinition Width="150"/></Grid.ColumnDefinitions>
                                        <TextBlock Text="{x:Bind Name, Mode=OneWay}" Style="{StaticResource TextCell}"/>
                                        <TextBlock Grid.Column="1" Text="{x:Bind Pid, Mode=OneWay}" Style="{StaticResource NumberCell}"/>
                                        <TextBlock Grid.Column="2" Text="{x:Bind Parent, Mode=OneWay}" Style="{StaticResource NumberCell}"/>
                                        <TextBlock Grid.Column="3" Text="{x:Bind Session, Mode=OneWay}" Style="{StaticResource NumberCell}"/>
                                        <TextBlock Grid.Column="4" Text="{x:Bind Cpu, Mode=OneWay}" Style="{StaticResource NumberCell}"/>
                                        <TextBlock Grid.Column="5" Text="{x:Bind WorkingSet, Mode=OneWay}" Style="{StaticResource NumberCell}"/>
                                        <TextBlock Grid.Column="6" Text="{x:Bind PrivateBytes, Mode=OneWay}" Style="{StaticResource NumberCell}"/>
                                        <TextBlock Grid.Column="7" Text="{x:Bind Read, Mode=OneWay}" Style="{StaticResource NumberCell}"/>
                                        <TextBlock Grid.Column="8" Text="{x:Bind Write, Mode=OneWay}" Style="{StaticResource NumberCell}"/>
                                        <TextBlock Grid.Column="9" Text="{x:Bind Threads, Mode=OneWay}" Style="{StaticResource NumberCell}"/>
                                        <TextBlock Grid.Column="10" Text="{x:Bind Handles, Mode=OneWay}" Style="{StaticResource NumberCell}"/>
                                        <TextBlock Grid.Column="11" Text="{x:Bind Started, Mode=OneWay}" Style="{StaticResource NumberCell}"/>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                            </Grid>
                        </ScrollViewer>
                    </Grid>
                    <Grid Grid.Row="1" x:Name="UsersView" Visibility="Collapsed">
                        <Grid.RowDefinitions><RowDefinition Height="36"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                        <Border Background="{ThemeResource SubtleFillColorSecondaryBrush}" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,1">
                            <Grid Padding="18,0,16,0" ColumnSpacing="12">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="90"/><ColumnDefinition Width="100"/><ColumnDefinition Width="90"/><ColumnDefinition Width="120"/><ColumnDefinition Width="130"/><ColumnDefinition Width="90"/></Grid.ColumnDefinitions>
                                <TextBlock Text="{loc:Localize Key=User}" Style="{StaticResource ColumnTitle}"/>
                                <TextBlock Grid.Column="1" Text="{loc:Localize Key=Session}" HorizontalAlignment="Right" Margin="0,0,6,0" Style="{StaticResource ColumnTitle}"/>
                                <TextBlock Grid.Column="2" Text="{loc:Localize Key=Processes}" HorizontalAlignment="Right" Margin="0,0,6,0" Style="{StaticResource ColumnTitle}"/>
                                <TextBlock Grid.Column="3" Text="{loc:Localize Key=CPU}" HorizontalAlignment="Right" Margin="0,0,6,0" Style="{StaticResource ColumnTitle}"/>
                                <TextBlock Grid.Column="4" Text="{loc:Localize Key=Memory}" HorizontalAlignment="Right" Margin="0,0,6,0" Style="{StaticResource ColumnTitle}"/>
                                <TextBlock Grid.Column="5" Text="{loc:Localize Key=InputOutput}" HorizontalAlignment="Right" Margin="0,0,6,0" Style="{StaticResource ColumnTitle}"/>
                                <TextBlock Grid.Column="6" Text="{loc:Localize Key=Threads}" HorizontalAlignment="Right" Margin="0,0,6,0" Style="{StaticResource ColumnTitle}"/>
                            </Grid>
                        </Border>
                        <ListView Grid.Row="1" x:Name="UserList" SelectionMode="Single" Padding="0"
                            ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.HorizontalScrollMode="Disabled">
                            <ListView.ItemContainerTransitions><TransitionCollection/></ListView.ItemContainerTransitions>
                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Padding" Value="0"/>
                                    <Setter Property="Margin" Value="0"/><Setter Property="MinHeight" Value="34"/>
                                </Style>
                            </ListView.ItemContainerStyle>
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="m:UserRow">
                                    <Grid Padding="18,0,16,0" MinHeight="34" ColumnSpacing="12">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="90"/><ColumnDefinition Width="100"/><ColumnDefinition Width="90"/><ColumnDefinition Width="120"/><ColumnDefinition Width="130"/><ColumnDefinition Width="90"/></Grid.ColumnDefinitions>
                                        <TextBlock Text="{x:Bind User, Mode=OneWay}" Style="{StaticResource TextCell}"/>
                                        <TextBlock Grid.Column="1" Text="{x:Bind Session, Mode=OneWay}" Style="{StaticResource NumberCell}"/>
                                        <TextBlock Grid.Column="2" Text="{x:Bind Count, Mode=OneWay}" Style="{StaticResource NumberCell}"/>
                                        <TextBlock Grid.Column="3" Text="{x:Bind Cpu, Mode=OneWay}" Style="{StaticResource NumberCell}"/>
                                        <TextBlock Grid.Column="4" Text="{x:Bind Memory, Mode=OneWay}" Style="{StaticResource NumberCell}"/>
                                        <TextBlock Grid.Column="5" Text="{x:Bind Io, Mode=OneWay}" Style="{StaticResource NumberCell}"/>
                                        <TextBlock Grid.Column="6" Text="{x:Bind Threads, Mode=OneWay}" Style="{StaticResource NumberCell}"/>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Grid>
                    <Grid Grid.Row="1" x:Name="ConnectionsView" Visibility="Collapsed">
                        <Grid.RowDefinitions><RowDefinition Height="36"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                        <Border Background="{ThemeResource SubtleFillColorSecondaryBrush}" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,1">
                            <Grid Padding="18,0,16,0" ColumnSpacing="12">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="70"/><ColumnDefinition Width="80"/><ColumnDefinition Width="3*"/><ColumnDefinition Width="3*"/><ColumnDefinition Width="130"/></Grid.ColumnDefinitions>
                                <TextBlock Text="{loc:Localize Key=ServiceProcess}" Style="{StaticResource ColumnTitle}"/>
                                <TextBlock Grid.Column="1" Text="PID" HorizontalAlignment="Right" Margin="0,0,6,0" Style="{StaticResource ColumnTitle}"/>
                                <TextBlock Grid.Column="2" Text="{loc:Localize Key=ConnectionProtocol}" Style="{StaticResource ColumnTitle}"/>
                                <TextBlock Grid.Column="3" Text="{loc:Localize Key=LocalEndpoint}" Style="{StaticResource ColumnTitle}"/>
                                <TextBlock Grid.Column="4" Text="{loc:Localize Key=RemoteEndpoint}" Style="{StaticResource ColumnTitle}"/>
                                <TextBlock Grid.Column="5" Text="{loc:Localize Key=ServiceStatus}" Style="{StaticResource ColumnTitle}"/>
                            </Grid>
                        </Border>
                        <ListView Grid.Row="1" x:Name="ConnectionList" SelectionMode="Single" DoubleTapped="ConnectionDoubleTapped" Padding="0"
                            AutomationProperties.Name="{loc:Localize Key=Connections}">
                            <ListView.ItemContainerTransitions><TransitionCollection/></ListView.ItemContainerTransitions>
                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Padding" Value="0"/>
                                    <Setter Property="Margin" Value="0"/><Setter Property="MinHeight" Value="34"/>
                                </Style>
                            </ListView.ItemContainerStyle>
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="m:ConnectionRow">
                                    <Grid Padding="18,0,16,0" MinHeight="34" ColumnSpacing="12">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="70"/><ColumnDefinition Width="80"/><ColumnDefinition Width="3*"/><ColumnDefinition Width="3*"/><ColumnDefinition Width="130"/></Grid.ColumnDefinitions>
                                        <TextBlock Text="{x:Bind Host, Mode=OneWay}" Style="{StaticResource TextCell}"/>
                                        <TextBlock Grid.Column="1" Text="{x:Bind Pid, Mode=OneWay}" Style="{StaticResource NumberCell}"/>
                                        <TextBlock Grid.Column="2" Text="{x:Bind Protocol, Mode=OneWay}" Style="{StaticResource TextCell}"/>
                                        <TextBlock Grid.Column="3" Text="{x:Bind Local, Mode=OneWay}" Style="{StaticResource TextCell}"/>
                                        <TextBlock Grid.Column="4" Text="{x:Bind Remote, Mode=OneWay}" Style="{StaticResource TextCell}"/>
                                        <TextBlock Grid.Column="5" Text="{x:Bind State, Mode=OneWay}" Style="{StaticResource TextCell}"/>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Grid>
                    <Grid Grid.Row="1" x:Name="StartupView" Visibility="Collapsed">
                        <Grid.RowDefinitions><RowDefinition Height="36"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                        <Border Background="{ThemeResource SubtleFillColorSecondaryBrush}" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,1">
                            <Grid Padding="18,0,16,0" ColumnSpacing="12">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="4*"/><ColumnDefinition Width="2*"/><ColumnDefinition Width="110"/><ColumnDefinition Width="2*"/></Grid.ColumnDefinitions>
                                <TextBlock Text="{loc:Localize Key=Name}" Style="{StaticResource ColumnTitle}"/>
                                <TextBlock Grid.Column="1" Text="{loc:Localize Key=StartupCommand}" Style="{StaticResource ColumnTitle}"/>
                                <TextBlock Grid.Column="2" Text="{loc:Localize Key=StartupSource}" Style="{StaticResource ColumnTitle}" ToolTipService.ToolTip="{loc:Localize Key=StartupHint}"/>
                                <TextBlock Grid.Column="3" Text="{loc:Localize Key=ServiceStatus}" Style="{StaticResource ColumnTitle}"/>
                                <TextBlock Grid.Column="4" Text="{loc:Localize Key=ServiceProcess}" Style="{StaticResource ColumnTitle}"/>
                            </Grid>
                        </Border>
                        <ListView Grid.Row="1" x:Name="StartupList" SelectionMode="Single" DoubleTapped="StartupDoubleTapped" RightTapped="StartupRightTapped" KeyDown="StartupKeyDown" Padding="0"
                            AutomationProperties.Name="{loc:Localize Key=StartupTab}">
                            <ListView.ItemContainerTransitions><TransitionCollection/></ListView.ItemContainerTransitions>
                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Padding" Value="0"/>
                                    <Setter Property="Margin" Value="0"/><Setter Property="MinHeight" Value="34"/>
                                </Style>
                            </ListView.ItemContainerStyle>
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="m:StartupRow">
                                    <Grid Padding="18,0,16,0" MinHeight="34" ColumnSpacing="12">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="4*"/><ColumnDefinition Width="2*"/><ColumnDefinition Width="110"/><ColumnDefinition Width="2*"/></Grid.ColumnDefinitions>
                                        <TextBlock Text="{x:Bind Name, Mode=OneWay}" Style="{StaticResource TextCell}"/>
                                        <TextBlock Grid.Column="1" Text="{x:Bind Command, Mode=OneWay}" Style="{StaticResource TextCell}" ToolTipService.ToolTip="{x:Bind Command, Mode=OneWay}"/>
                                        <TextBlock Grid.Column="2" Text="{x:Bind Source, Mode=OneWay}" Style="{StaticResource TextCell}"/>
                                        <TextBlock Grid.Column="3" Text="{x:Bind State, Mode=OneWay}" Style="{StaticResource TextCell}"/>
                                        <TextBlock Grid.Column="4" Text="{x:Bind Host, Mode=OneWay}" Style="{StaticResource TextCell}"/>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Grid>
                    <Grid Grid.Row="1" x:Name="ServicesView" Visibility="Collapsed">
                        <Grid.RowDefinitions><RowDefinition Height="36"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                        <Border Background="{ThemeResource SubtleFillColorSecondaryBrush}" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,1">
                            <Grid Padding="18,0,16,0" ColumnSpacing="12">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="3*"/><ColumnDefinition Width="120"/><ColumnDefinition Width="70"/><ColumnDefinition Width="2*"/></Grid.ColumnDefinitions>
                                <TextBlock Text="{loc:Localize Key=Name}" Style="{StaticResource ColumnTitle}"/>
                                <TextBlock Grid.Column="1" Text="{loc:Localize Key=ServiceDescription}" Style="{StaticResource ColumnTitle}"/>
                                <TextBlock Grid.Column="2" Text="{loc:Localize Key=ServiceStatus}" Style="{StaticResource ColumnTitle}"/>
                                <TextBlock Grid.Column="3" Text="PID" HorizontalAlignment="Right" Style="{StaticResource ColumnTitle}"/>
                                <TextBlock Grid.Column="4" Text="{loc:Localize Key=ServiceProcess}" Style="{StaticResource ColumnTitle}" ToolTipService.ToolTip="{loc:Localize Key=ServiceHint}"/>
                            </Grid>
                        </Border>
                        <ListView Grid.Row="1" x:Name="ServiceList" SelectionMode="Single" DoubleTapped="ServiceDoubleTapped" RightTapped="ServiceRightTapped" KeyDown="ServiceKeyDown" Padding="0"
                            AutomationProperties.Name="{loc:Localize Key=Services}">
                            <ListView.ItemContainerTransitions><TransitionCollection/></ListView.ItemContainerTransitions>
                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Padding" Value="0"/>
                                    <Setter Property="Margin" Value="0"/><Setter Property="MinHeight" Value="34"/>
                                </Style>
                            </ListView.ItemContainerStyle>
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="m:ServiceRow">
                                    <Grid Padding="18,0,16,0" MinHeight="34" ColumnSpacing="12">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="3*"/><ColumnDefinition Width="120"/><ColumnDefinition Width="70"/><ColumnDefinition Width="2*"/></Grid.ColumnDefinitions>
                                        <TextBlock Text="{x:Bind Name, Mode=OneWay}" Style="{StaticResource TextCell}"/>
                                        <TextBlock Grid.Column="1" Text="{x:Bind Title, Mode=OneWay}" Style="{StaticResource TextCell}"/>
                                        <TextBlock Grid.Column="2" Text="{x:Bind State, Mode=OneWay}" Style="{StaticResource TextCell}"/>
                                        <TextBlock Grid.Column="3" Text="{x:Bind Pid, Mode=OneWay}" HorizontalAlignment="Right" Style="{StaticResource TextCell}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                        <TextBlock Grid.Column="4" Text="{x:Bind Host, Mode=OneWay}" Style="{StaticResource TextCell}"/>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Grid>
                    <Grid Grid.Row="1" x:Name="SpaceView" Visibility="Collapsed" Padding="16,10,16,12" RowSpacing="10">
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                        <Grid RowSpacing="4" ColumnSpacing="8">
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <ComboBox x:Name="SpaceDrives" HorizontalAlignment="Stretch" AutomationProperties.Name="{loc:Localize Key=SpaceDriveLabel}"/>
                            <Button Grid.Column="1" x:Name="SpaceBrowse" Click="SpaceBrowseClicked" AutomationProperties.Name="{loc:Localize Key=SpaceBrowseLabel}" ToolTipService.ToolTip="{loc:Localize Key=SpaceBrowseLabel}"><FontIcon Glyph="&#xE838;" FontSize="14"/></Button>
                            <Button Grid.Column="2" x:Name="SpaceScan" Click="SpaceScanClicked"/>
                            <Button Grid.Column="3" x:Name="SpaceUp" IsEnabled="False" Click="SpaceUpClicked" AutomationProperties.Name="{loc:Localize Key=SpaceUpLabel}" ToolTipService.ToolTip="{loc:Localize Key=SpaceUpLabel}"><FontIcon Glyph="&#xE74A;" FontSize="14"/></Button>
                            <Button Grid.Column="4" x:Name="SpaceOpen" IsEnabled="False" Click="SpaceOpenClicked" AutomationProperties.Name="{loc:Localize Key=SpaceOpenLabel}" ToolTipService.ToolTip="{loc:Localize Key=SpaceOpenLabel}"><FontIcon Glyph="&#xE8DA;" FontSize="14"/></Button>
                            <TextBlock Grid.Row="1" Grid.ColumnSpan="5" x:Name="SpacePath" FontSize="13" TextTrimming="CharacterEllipsis"/>
                        </Grid>
                        <Grid Grid.Row="1" ColumnSpacing="12">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="3*"/><ColumnDefinition Width="2*"/></Grid.ColumnDefinitions>
                            <Canvas x:Name="SpaceMap" SizeChanged="SpaceMapSizeChanged"/>
                            <ListView Grid.Column="1" x:Name="SpaceItems" IsItemClickEnabled="True" ItemClick="SpaceItemClicked"
                                      SelectionMode="Single" AutomationProperties.Name="{loc:Localize Key=SpaceItemsLabel}">
                                <ListView.ItemContainerStyle>
                                    <Style TargetType="ListViewItem">
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Padding" Value="0"/><Setter Property="MinHeight" Value="32"/>
                                    </Style>
                                </ListView.ItemContainerStyle>
                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="m:SpaceRow">
                                        <Grid Padding="6,2" ColumnSpacing="6">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                            <FontIcon Glyph="{x:Bind Glyph}" FontSize="14" AutomationProperties.AccessibilityView="Raw"/>
                                            <TextBlock Grid.Column="1" Text="{x:Bind Name, Mode=OneWay}" Style="{StaticResource TextCell}" ToolTipService.ToolTip="{x:Bind Name, Mode=OneWay}"/>
                                            <TextBlock Grid.Column="2" Text="{x:Bind Amount, Mode=OneWay}" Style="{StaticResource TextCell}"/>
                                            <TextBlock Grid.Column="3" Text="{x:Bind Share, Mode=OneWay}" Style="{StaticResource TextCell}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </Grid>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
        <Border Grid.Row="2" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,1,0,0" Padding="24,0">
            <Grid>
                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <FontIcon x:Name="StatusIcon" Glyph="&#xE9D9;" FontSize="12" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                    <TextBlock x:Name="Status" Text="{loc:Localize Key=Collecting}" Style="{StaticResource CaptionTextBlockStyle}"/>
                </StackPanel>
                <TextBlock x:Name="Uptime" HorizontalAlignment="Right" VerticalAlignment="Center" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
            </Grid>
        </Border>
    </Grid>
</Window>

