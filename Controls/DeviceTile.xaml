<UserControl x:Class="Pulse.Controls.DeviceTile" x:Name="Tile"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:local="using:Pulse.Controls"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border Padding="10,7,10,8" CornerRadius="6" BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" Background="{ThemeResource SubtleFillColorSecondaryBrush}">
        <Grid RowSpacing="3">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="30"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBlock x:Name="Heading" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                <TextBlock Grid.Column="1" x:Name="Reading" Text="—" FontSize="12" Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
            </Grid>
            <local:Sparkline Grid.Row="1" x:Name="Graph" Foreground="{Binding Foreground, ElementName=Tile}"/>
            <TextBlock Grid.Row="1" x:Name="AxisLabel" HorizontalAlignment="Left" VerticalAlignment="Top" FontSize="10" IsHitTestVisible="False" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
            <TextBlock Grid.Row="2" x:Name="Caption" FontSize="11" TextTrimming="CharacterEllipsis" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
        </Grid>
    </Border>
</UserControl>
