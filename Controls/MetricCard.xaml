<UserControl x:Class="Pulse.Controls.MetricCard" x:Name="Card"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:loc="using:Pulse.Localization"
    xmlns:local="using:Pulse.Controls"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border Style="{StaticResource Surface}" Padding="15,11,15,10">
        <Grid RowSpacing="3">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition x:Name="PlotRow" Height="42"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <StackPanel Orientation="Horizontal" Spacing="8">
                <FontIcon x:Name="Symbol" FontSize="15" Foreground="{Binding Foreground, ElementName=Card}"/>
                <TextBlock x:Name="Heading" Style="{StaticResource BodyStrongTextBlockStyle}" Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
            </StackPanel>
            <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="5">
                <TextBlock x:Name="Number" Text="—" FontSize="29" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                <TextBlock x:Name="Unit" Margin="0,0,0,5" VerticalAlignment="Bottom" FontSize="14" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
            </StackPanel>
            <local:Sparkline Grid.Row="2" x:Name="Plot" Margin="0,2,0,1" Foreground="{Binding Foreground, ElementName=Card}"/>
            <TextBlock Grid.Row="3" x:Name="Caption" Text="{loc:Localize Key=Collecting}" FontSize="12" TextTrimming="CharacterEllipsis" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
        </Grid>
    </Border>
</UserControl>

