<Project>
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <!-- Isolate both the WinRT activation manifest and the self-contained runtime configuration. -->
    <IntermediateOutputPath>$(BaseIntermediateOutputPath)portable\$(Configuration)\</IntermediateOutputPath>
    <OutputPath>bin\portable\$(Configuration)\</OutputPath>
    <OutputPath Condition="'$(ArtifactsPath)' != ''">$(ArtifactsPath)\bin\$(MSBuildProjectName)\portable\$(Configuration)\</OutputPath>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <EnableMsixTooling>true</EnableMsixTooling>
    <!-- Bundle runtime assets and compiled resources. The MSIX default also picks up previous publish folders. -->
    <AutoIncludeCopyToPublishDirectoryItems>false</AutoIncludeCopyToPublishDirectoryItems>
    <!-- WinUI loads its native libraries and resources.pri from disk, so the bundle is extracted at startup. -->
    <IncludeAllContentForSelfExtract>true</IncludeAllContentForSelfExtract>
    <NoWarn>$(NoWarn);NETSDK1244</NoWarn>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
    <ProtectPortable Condition="'$(ProtectPortable)' == ''">true</ProtectPortable>
  </PropertyGroup>
</Project>

