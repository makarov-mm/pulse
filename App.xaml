<Application x:Class="Pulse.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Microsoft.UI.Xaml.Controls">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries><controls:XamlControlsResources /></ResourceDictionary.MergedDictionaries>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Default">
                    <SolidColorBrush x:Key="MemoryInk" Color="#C0A5FB"/>
                    <SolidColorBrush x:Key="DiskInk" Color="#75D6BF"/>
                    <SolidColorBrush x:Key="NetworkInk" Color="#F5BA7D"/>
                </ResourceDictionary>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="MemoryInk" Color="#7853A5"/>
                    <SolidColorBrush x:Key="DiskInk" Color="#117665"/>
                    <SolidColorBrush x:Key="NetworkInk" Color="#A55619"/>
                </ResourceDictionary>
                <ResourceDictionary x:Key="HighContrast">
                    <SolidColorBrush x:Key="MemoryInk" Color="{ThemeResource SystemColorWindowTextColor}"/>
                    <SolidColorBrush x:Key="DiskInk" Color="{ThemeResource SystemColorWindowTextColor}"/>
                    <SolidColorBrush x:Key="NetworkInk" Color="{ThemeResource SystemColorWindowTextColor}"/>
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
            <Style x:Key="Surface" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}"/>
                <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="CornerRadius" Value="8"/>
            </Style>
            <Style x:Key="TableHeader" TargetType="Button" BasedOn="{StaticResource SubtleButtonStyle}">
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Padding" Value="6,3"/>
                <Setter Property="MinWidth" Value="0"/>
                <Setter Property="HorizontalAlignment" Value="Stretch"/>
                <Setter Property="HorizontalContentAlignment" Value="Right"/>
            </Style>
            <Style x:Key="SortHeader" TargetType="Button" BasedOn="{StaticResource TableHeader}">
                <Setter Property="Padding" Value="0,3"/>
            </Style>
            <Style x:Key="TextCell" TargetType="TextBlock">
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
            </Style>
            <Style x:Key="NumberCell" TargetType="TextBlock">
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="HorizontalAlignment" Value="Right"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="Margin" Value="0,0,6,0"/>
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>

